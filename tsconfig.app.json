{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    /* Off: the installed webds task-flow-view (r/tools, 0.33) has an unused
       map parameter, and installed files are not edited. */
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/bbl/*": ["./src/components/bbl/*"],
      "@/patterns/*": ["./src/components/patterns/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
  }
